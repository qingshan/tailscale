PKG_ID=tailscale
DAEMON=tsctl
LIPC_ID=dev.qingshan.tsctl
APP_ID=dev.qingshan.tailscale
DEST=/mnt/us/tailscale
# bin/ holds the downloaded tailscale and tailscaled binaries.
# var/ holds the auth key and node state. Both must survive an upgrade.
KEEP_ON_UPGRADE="bin var"
UPSTART_NAME=tsctl
EXTRA_UPSTART="tailscale-watchdog"
PKG_PKILL_ON_INSTALL=0
